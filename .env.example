# Copy to .env and fill in what you use. .env is ignored by git and never
# committed. A real environment variable wins over a value in this file, so a
# service unit or a container can override any of them.

# --- The database --------------------------------------------------------------
# Where PostgreSQL listens. Left empty, the local container that
# docker-compose.yml starts: postgresql://arpenteur:arpenteur@127.0.0.1:5433/arpenteur
DATABASE_URL=
# The password docker compose gives the container (arpenteur when empty). When
# you change it, change DATABASE_URL with it.
POSTGRES_PASSWORD=

# --- Zefix, the federal register ------------------------------------------------
# Free credentials by email to zefix@bj.admin.ch. Until they arrive, the stages
# that read the register refuse and say so; the test suite runs on fixtures.
ZEFIX_USER=
ZEFIX_PASSWORD=
# Optional: another host for the API, for a mirror or a test server. Left empty,
# [zefix] base_url in arpenteur.toml is used.
ZEFIX_URL=

# --- Model access (Anthropic) --------------------------------------------------
# Leave the key empty to run on a Claude subscription through the Claude Code
# CLI (`claude`), signed in once on this machine. Set a key to pay per call
# through the API instead. Which of the two is used is decided by llm.auth_mode
# in arpenteur.toml.
ANTHROPIC_API_KEY=
# Optional: where the CLI keeps its sign-in, when it is not in the default place.
ANTHROPIC_CONFIG_DIR=

# --- The mailbox Arpenteur reads (IMAP): replies, bounces, opt-outs -------------
MAIL_IMAP_SERVER=
MAIL_IMAP_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Sending (SMTP): the test and the waves of a campaign -------------------------
# Each of these falls back to the mailbox value above when left empty, so a
# mailbox whose IMAP and SMTP credentials are the same needs only the server.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (the default) or ssl.
SMTP_SECURITY=
# The From address; the username when empty. The Reply-To must be the mailbox
# read above, or an opt-out arrives where nothing reads it.
SMTP_SENDER=
SMTP_REPLY_TO=

# --- Infomaniak aliases ----------------------------------------------------------
# A mailbox hosted at Infomaniak can keep its credentials under the host's own
# names. They are read when the generic MAIL_* and SMTP_* names above are empty.
INFOMANIAK_USERNAME=
INFOMANIAK_PASSWORD=
INFOMANIAK_IMAP_SERVER=
INFOMANIAK_IMAP_PORT=
INFOMANIAK_SMTP_SERVER=
INFOMANIAK_SMTP_PORT=

# --- Infomaniak AI ------------------------------------------------------------------
# Not wired: the provider slot exists and refuses to run. Leave empty.
INFOMANIAK_API_KEY=
INFOMANIAK_AI_PRODUCT_ID=
