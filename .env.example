# Copy to .env and fill in. .env is gitignored and never committed.

# Zefix PublicREST API (HTTP Basic). Free credentials by email to
# zefix@bj.admin.ch. Until they arrive, the test suite runs on fixtures.
ZEFIX_USER=
ZEFIX_PASSWORD=

# Anthropic, used by the profile and draft stages.
#
# Optional. Leave it empty to run on a Claude subscription instead: sign in
# once with `ant auth login` and the SDK finds that profile by itself. Which
# of the two is used is set by llm.auth_mode in arpenteur.toml, and the
# subscription token is never copied into this file.
ANTHROPIC_API_KEY=

# Infomaniak AI (later phase; the provider slot exists but is not wired yet).
INFOMANIAK_API_KEY=
INFOMANIAK_AI_PRODUCT_ID=
